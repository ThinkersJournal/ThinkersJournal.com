---
import PageLayout from '../layouts/PageLayout.astro';
import { SUPPORT } from '../consts';
const liveAvenues = SUPPORT.filter((s) => s.live);
const comingSoon = SUPPORT.filter((s) => !s.live).map((s) => s.label);
---
<PageLayout
  title="Support"
  eyebrow="Support the mission"
  heading="Keep the door open for the next thinker."
  intro="Thinker's Journal has no funding yet. Every contribution — of any size, through whichever avenue suits you — goes straight toward keeping our help free or below market. We deliberately favor low-fee platforms so more of your gift arrives.">
  <p id="oc-total" class="raised" hidden aria-live="polite"></p>
  <div class="grid">
    {liveAvenues.map((s) => (
      <a class="card" href={s.href} target="_blank" rel="noopener">
        <div class="name">{s.label}</div>
        <div class="note">{s.note}</div>
        <div class="go">Give →</div>
      </a>
    ))}
  </div>
  {comingSoon.length > 0 && (
    <p class="soon">More avenues on the way: {comingSoon.join(', ')}.</p>
  )}
  <p class="foot">Prefer another way to give, or want to sponsor something specific? Reach out at <a class="link" href="mailto:hello@thinkersjournal.com">hello@thinkersjournal.com</a> — we'll add more avenues here over time.</p>
</PageLayout>
<script>
  // Progressive enhancement: reveal a live Open Collective total ONLY when there is a
  // meaningful one. No JS, a failed/absent endpoint, an { ok:false } payload, or a total
  // below the floor all leave the element hidden — it never renders "$0" or a trivial number.
  const MIN_DISPLAY_CENTS = 10000; // $100 — tune freely; below this we show nothing
  const el = document.getElementById('oc-total');
  if (el) {
    fetch('/api/oc-total')
      .then((r) => (r.ok ? r.json() : null))
      .then((d) => {
        if (!d || d.ok !== true || typeof d.amountCents !== 'number') return;
        if (d.amountCents < MIN_DISPLAY_CENTS) return;
        const amount = new Intl.NumberFormat('en-US', {
          style: 'currency',
          currency: d.currency || 'USD',
          minimumFractionDigits: 0,
          maximumFractionDigits: 0,
        }).format(d.amountCents / 100);
        el.textContent = `${amount} raised so far — thank you.`;
        el.hidden = false;
      })
      .catch(() => { /* leave hidden */ });
  }
</script>
<style>
  .grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:18px}
  .card{border:1px solid var(--line);border-radius:14px;padding:24px;background:var(--ink2);
    transition:transform .15s ease,border-color .2s ease}
  .card:hover{transform:translateY(-3px);border-color:rgba(61,255,149,.45)}
  .name{font-family:var(--serif);font-size:21px;color:var(--head)}
  .note{color:var(--muted);font-size:14px;margin-top:8px}
  .go{color:var(--green);font-weight:600;font-size:14px;margin-top:18px}
  .soon{color:var(--dim);font-size:14px;margin-top:16px}
  .foot{color:var(--muted);margin-top:32px;font-size:16px;max-width:60ch}
  .raised{color:var(--green);font-weight:600;font-size:15px;letter-spacing:.02em;margin:0 0 22px}
  .raised[hidden]{display:none}
</style>
